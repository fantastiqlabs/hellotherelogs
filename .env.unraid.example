# Set the Warcraft Logs V2 API client credentials on the Unraid server.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Web UI port on the Unraid host.
LOGTASTIQ_PORT=8080
LOGTASTIQ_DATA_PATH=/mnt/user/appdata/logtastiq/data

# Optional: pin both images to the same Git commit instead of following latest.
# LOGTASTIQ_BACKEND_IMAGE=ghcr.io/fantastiqlabs/logtastiq-backend:sha-0123456789abcdef0123456789abcdef01234567
# LOGTASTIQ_FRONTEND_IMAGE=ghcr.io/fantastiqlabs/logtastiq-frontend:sha-0123456789abcdef0123456789abcdef01234567

CACHE_TTL_SECONDS=900
WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WCL_GRAPHQL_URL=https://fresh.warcraftlogs.com/api/v2/client
FRONTEND_ORIGIN=http://localhost:8080
